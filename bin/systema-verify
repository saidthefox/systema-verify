#!/usr/bin/env node
// A shim, not logic. The verifier is TypeScript because the LAW is TypeScript — shipping a
// compiled copy would put a third version of the reducer into the world, which is the exact
// failure this package was rebuilt to prevent. So we run the sources.
require("tsx/cjs")
require("../verify.ts").main().catch(e => {
  console.error("\nerror: " + (e && e.message ? e.message : e))
  process.exit(2)
})
